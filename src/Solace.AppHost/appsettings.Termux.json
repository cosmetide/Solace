{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "Termux": {
    "Enabled": true
  },
  "Shared": {
    "AcceptMinecraftEula": false,
    "FixUpBuildplatesOnImport": false,
    "StaticDataPath": "../../staticdata",
    "ResolvePaths": true,
    "Captcha": {
      "Provider": "NoOp",
      "CloudflareTurnstileSiteKey": "",
      "CloudflareTurnstileSecretKey": ""
    },
    "PublicEndpoints": {
      "WebPortal": "http://127.0.0.1:5000",
      "Locator": "http://127.0.0.1:8080",
      "AuthServer": "http://127.0.0.1:8088",
      "ApiServer": "http://127.0.0.1:8089",
      "Cdn": "http://127.0.0.1:8090"
    },
    "Oidc": {
      "WebPortal": {
        "SigningCertPath": "",
        "SigningCertPassword": "",
        "EncryptionCertPath": "",
        "EncryptionCertPassword": "",
        "AuthServer": {
          "ClientId": "solace-auth-server",
          "ClientSecret": "termux_secret_change_me",
          "DisplayName": "Solace",
          "AllowInsecure": true
        }
      }
    }
  },
  "ObjectStore": {
    "DataDirectory": "../../data/object_store"
  },
  "Locator": {
    "Port": 8080
  },
  "AuthServer": {
    "Port": 8088,
    "Authentication": {
      "Login": {
        "SoapHeaderValidityMinutes": 1,
        "UserTokenValidityMinutes": 10080,
        "DeviceTokenValidityMinutes": 1,
        "XboxTokenValidityMinutes": 10080
      },
      "XboxLive": {
        "TokenValidityMinutes": 10080
      },
      "PlayfabApi": {
        "EntityTokenValidityMinutes": 1440,
        "SessionTicketValidityMinutes": 1440
      }
    }
  },
  "Cdn": {
    "Port": 8090
  },
  "ApiServer": {
    "Port": 8089,
    "Authentication": {
      "LocalLoginOnly": true
    }
  },
  "BuildplateLauncher": {
    "PublicEndpoint": "127.0.0.1",
    "BaseInstancePublicPort": 19132,
    "FountainBridgeJarName": "fountain-{{version}}-SNAPSHOT-jar-with-dependencies.jar",
    "FabricJarName": "server-{{version}}.jar",
    "ConnectorPluginJarName": "buildplate-connector-plugin-{{version}}-SNAPSHOT-jar-with-dependencies.jar"
  },
  "TileRenderer": {
    "TileSource": {
      "TileJsonUrl": "https://tiles.openfreemap.org/planet",
      "TileDatabaseConnectionString": ""
    }
  },
  "WebPortal": {
    "Port": 5000,
    "AdminAccountPassword": "",
    "BuildplatePreview": {
      "Enabled": true,
      "GenerationMaxConcurrency": 1
    }
  }
}
